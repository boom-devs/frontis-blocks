{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "frontis-blocks/advanced-video",
	"version": "1.0.0",
	"title": "Advanced Video",
	"category": "frontis-blocks",
	"icon": "video-alt3",
	"description": "Example block scaffolded with Create Block tool.",
	"example": {},
    "supports": {
        "anchor": false,
		"align": ["wide", "full"],
        "customClassName": false
    },
	"textdomain": "frontis-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"attributes": {
		"blockID": {
			"type": "string",
			"default": ""
		},
		"DeviceType": {
			"type": "string",
			"default": "Desktop"
		},
		"videoGlobalZIndex": {
			"type": "string",
			"default": "number"
		},
		"videoURL": {
			"type": "string",
			"default": "https://www.youtube.com/watch?v=WZdCL4Y5EBY"
		},
		"autoPlaySwitcher": {
			"type": "boolean",
			"default": false
		},
		"muteSwitcher": {
			"type": "boolean",
			"default": false
		},
		"loopSwitcher": {
			"type": "boolean",
			"default": false
		},
		"showControlsSwitcher": {
			"type": "boolean",
			"default": false
		},
		"videoBorder": {
			"type": "string",
			"default": "none"
		},
		"videoBorderColorSwitcher": {
			"type": "string",
			"default": "normal"
		},
		"videoBorderColor": {
			"type": "string"
		},
		"videoBorderHoverColor": {
			"type": "string"
		},
		"videoBorderUnits": {
			"type": "object",
			"default": {
				"Desktop": "px",
				"Tablet": "px",
				"Mobile": "px"
			}
		},
		"videoBorderDesktop": {
			"type": "object",
			"default": {
				"top": 0,
				"bottom": 0,
				"left": 0,
				"right": 0
			}
		},
		"videoBorderTablet": {
			"type": "object",
			"default": {
				"top": 0,
				"bottom": 0,
				"left": 0,
				"right": 0
			}
		},
		"videoBorderMobile": {
			"type": "object",
			"default": {
				"top": 0,
				"bottom": 0,
				"left": 0,
				"right": 0
			}
		},
		"videoBorderLink": {
			"type": "boolean",
			"default": true
		},
		"videoBorderRadiusUnits": {
			"type": "object",
			"default": {
				"Desktop": "px",
				"Tablet": "px",
				"Mobile": "px"
			}
		},
		"videoBorderRadiusDesktop": {
			"type": "object",
			"default": {
				"top": 10,
				"bottom": 10,
				"left": 10,
				"right": 10
			}
		},
