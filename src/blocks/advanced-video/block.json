{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "frontis-blocks/advanced-video",
	"version": "1.0.0",
	"title": "Advanced Video",
	"category": "frontis-blocks",
	"icon": "video-alt3",
	"description": "Example block scaffolded with Create Block tool.",
	"example": {},
    "supports": {
        "anchor": false,
		"align": ["wide", "full"],
        "customClassName": false
    },
	"textdomain": "frontis-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"attributes": {
		"blockID": {
			"type": "string",
			"default": ""
		 },
		 "DeviceType": {
			"type": "string",
			"default": "Desktop"
		 },
		 "videoGlobalZIndex": {
			"type": "string",
			"default": "number"
		 },
		"videoURL": {
		   "type": "string",
		   "default": "https://www.youtube.com/watch?v=WZdCL4Y5EBY"
		},
		"autoPlaySwitcher": {
		   "type": "boolean",
		   "default": false
		},
		"muteSwitcher": {
		   "type": "boolean",
		   "default": false
		},
		"loopSwitcher": {
		   "type": "boolean",
		   "default": false
		},
		"showControlsSwitcher": {
		   "type": "boolean",
		   "default": false
		}
	 },
	"render": "file:./render.php"
}
