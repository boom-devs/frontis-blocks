{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "frontis-blocks/slider",
    "version": "1.0.0",
    "title": "Slider",
    "category": "frontis-blocks",
    "textdomain": "frontis-blocks",
    "description": "A customizable slider block for displaying slides with various styling options.",
    "icon": "images-alt2",
    "example": {},
    "supports": {
        "anchor": false,
        "align": ["wide", "full"],
        "customClassName": false
    },
    "editorScript": [
        "file:./index.js",
        "frontis-swiper-script"
    ],
    "editorStyle": [
        "file:./index.css",
        "frontis-swiper-style"
    ],
    "style": [
        "file:./style-index.css",
        "frontis-swiper-style"
    ],
    "viewScript": [
        "file:./view.js",
        "frontis-swiper-script"
    ]

}
