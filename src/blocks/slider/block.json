{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "frontis-blocks/slider",
    "version": "1.0.0",
    "title": "Slider",
    "category": "frontis-blocks",
    "textdomain": "frontis-blocks",
    "description": "A slider block for displaying slides.",
    "icon": "images-alt2",
    "example": {},
    "supports": {
        "anchor": false,
        "align": ["wide", "full"],
        "customClassName": false
    },
    "providesContext": {
        "fb/sliderID": "blockId",
        "fb/sliderInheritedTransitionType": "transitionType",
        "fb/sliderInheritedDisplayIndicators": "displayIndicators",
        "fb/sliderInheritedIndicatorColor": "indicatorColor",
        "fb/sliderInheritedAutoplay": "autoplay",
        "fb/sliderInheritedAutoplaySpeed": "autoplaySpeed",
        "fb/sliderInheritedNavigationArrows": "navigationArrows"
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "viewScript": "file:./view.js"
}
