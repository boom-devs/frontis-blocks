{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "frontis-blocks/grid-layout",
	"version": "0.1.0",
	"title": "Grid Layout Builder",
	"category": "frontis-blocks",
	"icon": "grid-view",
	"description": "A draggable and resizable grid layout builder for Gutenberg.",
	"attributes": {
		"cols": {
			"type": "number",
			"default": 12
		},
		"rowHeight": {
			"type": "number",
			"default": 40
		},
		"gutter": {
			"type": "number",
			"default": 10
		},
		"compactType": {
			"type": "string",
			"default": "vertical"
		},
		"allowOverlap": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"textdomain": "frontis-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}