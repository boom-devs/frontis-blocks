{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "frontis-blocks/news-ticker",
	"version": "1.0.0",
	"title": "News Ticker",
	"category": "frontis-blocks",
	"description": "A customizable news ticker block with various styling options.",
	"example": {},
