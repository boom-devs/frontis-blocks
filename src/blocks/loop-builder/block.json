{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "frontis-blocks/loop-builder",
    "version": "1.0.0",
    "title": "Loop Builder",
    "category": "frontis-blocks",
    "icon": "grid-view",
    "description": "Create custom post loops with full design control",
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "attributes": {
        "blockID": {
            "type": "string"
        },
        "query": {
            "type": "object",
            "default": {
                "perPage": 6,
                "pages": 0,
                "offset": 0,
                "postType": "post",
                "order": "desc",
                "orderBy": "date",
                "author": "",
                "search": "",
                "exclude": [],
                "sticky": "",
                "inherit": false
            }
        },
        "displayLayout": {
            "type": "object",
            "default": {
                "type": "flex",
                "columns": 3
            }
        },
        "namespace": {
            "type": "string",
            "default": "frontis-blocks/custom-loop"
        }
    },
    "textdomain": "frontis-blocks",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./editor.scss",
    "style": "file:./style.scss"
}