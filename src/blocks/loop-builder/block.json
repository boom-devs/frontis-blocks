{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "frontis-blocks/loop-builder",
    "version": "1.0.0",
    "title": "Loop Builder",
    "category": "frontis-blocks",
    "icon": "grid-view",
    "description": "Create custom post loops with full design control",
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "attributes": {
        "blockID": {
            "type": "string"
        },
        "postType": {
            "type": "string",
            "default": "post"
        },
        "postsPerPage": {
            "type": "number",
            "default": 6
        },
        "order": {
            "type": "string",
            "default": "desc"
        },
        "orderBy": {
            "type": "string",
            "default": "date"
        },
        "includedCategories": {
            "type": "array",
            "default": []
        },
        "includedTags": {
            "type": "array",
            "default": []
        },
        "offset": {
            "type": "number",
            "default": 0
        },
        "columns": {
            "type": "number",
            "default": 3
        },
        "gap": {
            "type": "number",
            "default": 20
        }
    },
    "textdomain": "frontis-blocks",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./editor.scss",
    "style": "file:./style.scss",
    "render": "file:./render.php"
}