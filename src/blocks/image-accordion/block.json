{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "frontis-blocks/image-accordion",
	"version": "1.0.0",
	"title": "Image Accordion",
	"category": "frontis-blocks",
	"icon": "images-alt2",
	"description": "Interactive image accordion with 4 preset styles. Supports hover and click triggers.",
	"keywords": ["accordion", "image", "gallery", "interactive", "slider"],
	"textdomain": "frontis-blocks",
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
