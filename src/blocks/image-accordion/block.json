{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "frontis-blocks/image-accordion",
	"version": "1.0.0",
	"title": "Image Accordion",
	"category": "frontis-blocks",
	"icon": "images-alt2",
	"description": "A beautiful image accordion with 4 preset styles. Hover or click to expand panels.",
	"keywords": ["image", "accordion", "animation", "gallery", "interactive"],
	"textdomain": "frontis-blocks",
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.scss",
	"style": "file:./style.scss",
	"viewScript": "file:./view.js"
}
